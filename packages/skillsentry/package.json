{
  "name": "skillsentry",
  "version": "0.1.0",
  "description": "Local-first security scanner for AI agent skills (SKILL.md) and MCP server configs. Static rules + open-weight model analysis, zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "SkillSentry contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ulk0r0/skillsentry.git"
  },
  "bugs": "https://github.com/Ulk0r0/skillsentry/issues",
  "homepage": "https://github.com/Ulk0r0/skillsentry#readme",
  "keywords": [
    "mcp",
    "security",
    "agents",
    "agent-skills",
    "skill-md",
    "prompt-injection",
    "tool-poisoning",
    "owasp",
    "llm",
    "ollama",
    "open-weight",
    "scanner",
    "static-analysis"
  ],
  "bin": {
    "skillsentry": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
